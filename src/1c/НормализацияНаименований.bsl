////////////////////////////////////////////////////////////////////////////////
// Общий модуль «НормализацияНаименований»
//
// Порт src/normalize.js и src/match/attrs.js.
//
// Наименования поставщиков приходят как попало: капсом, с брендом в середине,
// с граммовкой слитно, с латиницей вперемешку с кириллицей. Модуль приводит
// строку к сравнимому виду и вытаскивает всё измеримое — объём, вес, фасовку,
// процент жирности, размер, цвет — в отдельные поля.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Полный разбор наименования. Форма результата одна для строк поставщика и
// для позиций справочника — их сравнивают между собой.
//
Функция РазобратьНаименование(Наименование) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Исходное", СокрЛП(Строка(Наименование)));

	Очищенное = ОчиститьСтроку(Результат.Исходное);

	Процент = ИзвлечьПроцент(Очищенное);
	Очищенное = Процент.Остаток;

	Величины = ИзвлечьВеличины(Очищенное);

	Результат.Вставить("Очищенное", Очищенное);
	Результат.Вставить("Процент", Процент.Значение);
	Результат.Вставить("Величины", Величины.Значения);
	Результат.Вставить("Токены", Токенизировать(Величины.Остаток));
	Результат.Вставить("Триграммы", Триграммы(Очищенное));
	Результат.Вставить("Размер", ИзвлечьРазмер(Результат.Исходное));
	Результат.Вставить("Цвет", ИзвлечьЦвет(Результат.Исходное));

	// Латинские токены — почти всегда бренд, сильный признак совпадения.
	Латиница = Новый Массив;
	Для Каждого Токен Из Результат.Токены Цикл
		Если ЭтоЛатинскийТокен(Токен) Тогда
			Латиница.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Латиница", Латиница);

	Возврат Результат;

КонецФункции

// Мера близости строки поставщика и позиции справочника, 0..1.
//
// Веса подобраны на стенде эталонной реализации. Основной вклад даёт
// вхождение: наименование в справочнике почти всегда короче строки
// поставщика («Гель для стирки» против «ГЕЛЬ ДЛЯ СТИРКИ BIMAX COLOR 1,3Л»),
// и симметричная мера такие пары штрафует незаслуженно.
//
Функция Близость(Поставщик, Кандидат) Экспорт

	Вхождение = Вхождение(Кандидат.Токены, Поставщик.Токены);
	Жаккар    = Жаккар(Кандидат.Токены, Поставщик.Токены);
	Триграммы = БлизостьМножеств(Кандидат.Триграммы, Поставщик.Триграммы);
	Бренд     = ДоляСовпавшихБрендов(Кандидат.Латиница, Поставщик.Токены);
	Фасовка   = ?(ВеличиныСовпали(Поставщик.Величины, Кандидат.Величины), 1, 0);

	Возврат 0.42 * Вхождение
	      + 0.14 * Жаккар
	      + 0.24 * Триграммы
	      + 0.12 * Бренд
	      + 0.08 * Фасовка;

КонецФункции

// Жёсткая проверка совместимости по размеру и цвету.
//
// Правило асимметрично намеренно: если атрибут задан у обеих сторон, он
// обязан совпасть; если хотя бы у одной отсутствует — не мешаем, пусть
// решает текстовая близость. Так отсекается подмена размера, но не ломается
// сопоставление обычных товаров, где размеров нет вовсе.
//
Функция АтрибутыСовместимы(Поставщик, Кандидат) Экспорт

	Если ЗначениеЗаполнено(Поставщик.Размер) И ЗначениеЗаполнено(Кандидат.Размер)
		И Поставщик.Размер <> Кандидат.Размер Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(Поставщик.Цвет) И ЗначениеЗаполнено(Кандидат.Цвет)
		И Поставщик.Цвет <> Кандидат.Цвет Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// --- чистка -----------------------------------------------------------------

Функция ОчиститьСтроку(Исходная)

	Строка = РазделитьАлфавиты(Исходная);
	Строка = НРег(Строка);
	Строка = СтрЗаменить(Строка, "ё", "е");

	Разделители = """'`«»(){}[].,;:!?";
	Для Позиция = 1 По СтрДлина(Разделители) Цикл
		Строка = СтрЗаменить(Строка, Сред(Разделители, Позиция, 1), " ");
	КонецЦикла;

	Возврат СокрЛП(СхлопнутьПробелы(Строка));

КонецФункции

// Вставляет пробел на стыке кириллицы и латиницы: «БЕЛЫЙXS» → «БЕЛЫЙ XS».
// Поставщики регулярно склеивают слова при выгрузке, и чаще всего склейка
// происходит именно на смене алфавита. Пока размер не отделён в отдельный
// токен, его не видно, и вся размерная сетка становится неразличимой.
Функция РазделитьАлфавиты(Исходная)

	Результат = "";
	ПредыдущийТип = "";

	Для Позиция = 1 По СтрДлина(Исходная) Цикл
		Символ = Сред(Исходная, Позиция, 1);
		ТекущийТип = ТипСимвола(Символ);

		Если ЗначениеЗаполнено(ПредыдущийТип) И ЗначениеЗаполнено(ТекущийТип)
			И ПредыдущийТип <> ТекущийТип Тогда
			Результат = Результат + " ";
		КонецЕсли;

		Результат = Результат + Символ;
		ПредыдущийТип = ТекущийТип;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТипСимвола(Символ)
	Код = КодСимвола(Символ);
	// латиница
	Если (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122) Тогда
		Возврат "lat";
	КонецЕсли;
	// кириллица, включая Ё/ё
	Если (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105 Тогда
		Возврат "cyr";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СхлопнутьПробелы(Исходная)
	Результат = Исходная;
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- величины ---------------------------------------------------------------

// Вытаскивает объём и вес, приводя к базовым единицам: граммы и миллилитры.
// Возвращает найденные величины и строку без них — дальше сравнивать удобнее
// по «голому» тексту, а числа сопоставлять отдельно.
Функция ИзвлечьВеличины(Строка)

	Значения = Новый Массив;
	Остаток = "";

	Части = СтрРазделить(Строка, " ", Ложь);
	Для Каждого Часть Из Части Цикл
		Величина = РазобратьВеличину(Часть);
		Если Величина = Неопределено Тогда
			Остаток = Остаток + ?(ПустаяСтрока(Остаток), "", " ") + Часть;
		Иначе
			Значения.Добавить(Величина);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Значения", Значения);
	Результат.Вставить("Остаток", Остаток);
	Возврат Результат;

КонецФункции

// Разбирает токен вида «1,3л», «450мл», «120гр», «20x225гр».
Функция РазобратьВеличину(Токен)

	Работа = НРег(Токен);
	Множитель = 1;

	// фасовка «20x225гр» — множитель и единичный объём
	Для Каждого Знак Из СтрРазделить("x,х,*", ",", Ложь) Цикл
		Позиция = СтрНайти(Работа, Знак);
		Если Позиция > 1 Тогда
			Левая = Лев(Работа, Позиция - 1);
			Если ЭтоЧисло(Левая) Тогда
				Множитель = Число(Левая);
				Работа = Сред(Работа, Позиция + 1);
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// отделяем число от единицы
	ЧисловаяЧасть = "";
	Позиция = 1;
	Пока Позиция <= СтрДлина(Работа) Цикл
		Символ = Сред(Работа, Позиция, 1);
		Если СтрНайти("0123456789.,", Символ) > 0 Тогда
			ЧисловаяЧасть = ЧисловаяЧасть + ?(Символ = ",", ".", Символ);
			Позиция = Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ЧисловаяЧасть) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Единица = СокрЛП(Сред(Работа, Позиция));
	Приведение = ПривестиЕдиницу(Единица);
	Если Приведение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Единица", Приведение.Единица);
	Результат.Вставить("Количество", Число(ЧисловаяЧасть) * Приведение.Коэффициент);
	Результат.Вставить("Множитель", Множитель);
	Возврат Результат;

КонецФункции

Функция ПривестиЕдиницу(Единица)

	Соответствия = Новый Соответствие;
	Соответствия.Вставить("кг", Новый Структура("Единица, Коэффициент", "г", 1000));
	Соответствия.Вставить("kg", Новый Структура("Единица, Коэффициент", "г", 1000));
	Соответствия.Вставить("г",  Новый Структура("Единица, Коэффициент", "г", 1));
	Соответствия.Вставить("гр", Новый Структура("Единица, Коэффициент", "г", 1));
	Соответствия.Вставить("g",  Новый Структура("Единица, Коэффициент", "г", 1));
	Соответствия.Вставить("л",  Новый Структура("Единица, Коэффициент", "мл", 1000));
	Соответствия.Вставить("l",  Новый Структура("Единица, Коэффициент", "мл", 1000));
	Соответствия.Вставить("мл", Новый Структура("Единица, Коэффициент", "мл", 1));
	Соответствия.Вставить("ml", Новый Структура("Единица, Коэффициент", "мл", 1));

	Возврат Соответствия.Получить(Единица);

КонецФункции

Функция ИзвлечьПроцент(Строка)

	Результат = Новый Структура("Значение, Остаток", 0, Строка);
	Позиция = СтрНайти(Строка, "%");
	Если Позиция = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// собираем число слева от знака процента
	Числовая = "";
	Индекс = Позиция - 1;
	Пока Индекс >= 1 Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если СтрНайти("0123456789.,", Символ) > 0 Тогда
			Числовая = ?(Символ = ",", ".", Символ) + Числовая;
			Индекс = Индекс - 1;
		ИначеЕсли Символ = " " И ПустаяСтрока(Числовая) Тогда
			Индекс = Индекс - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(Числовая) И ЭтоЧисло(Числовая) Тогда
		Результат.Значение = Число(Числовая);
		Результат.Остаток = СхлопнутьПробелы(
			Лев(Строка, Индекс) + " " + Сред(Строка, Позиция + 1));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// --- токены -----------------------------------------------------------------

Функция Токенизировать(Строка)

	Стоп = СтопСлова();
	Сокращения = Сокращения();
	Результат = Новый Массив;

	Заготовка = СтрЗаменить(СтрЗаменить(Строка, "/", " "), "\", " ");
	Заготовка = СтрЗаменить(Заготовка, "-", " ");

	Для Каждого Токен Из СтрРазделить(Заготовка, " ", Ложь) Цикл
		Значение = СокрЛП(Токен);
		Если ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;

		Развёрнутое = Сокращения.Получить(Значение);
		Если Развёрнутое <> Неопределено Тогда
			Значение = Развёрнутое;
		КонецЕсли;

		Если Стоп.Получить(Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДлина(Значение) <= 1 И НЕ СодержитЦифру(Значение) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Слова, встречающиеся почти в каждом наименовании: ничего не различают,
// а схожесть раздувают.
Функция СтопСлова()
	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить("для,и,с,в,на,из,по,от,а,же,шт,штук,уп,упак,пач", ",", Ложь) Цикл
		Результат.Вставить(Слово, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Сокращения()
	Результат = Новый Соответствие;
	Результат.Вставить("ср-во", "средство");
	Результат.Вставить("срво", "средство");
	Результат.Вставить("раств", "растворимый");
	Результат.Вставить("нат", "натуральный");
	Результат.Вставить("молоч", "молочный");
	Результат.Вставить("шок", "шоколад");
	Результат.Вставить("мультифр", "мультифрукт");
	Результат.Вставить("тп", "тетрапак");
	Возврат Результат;
КонецФункции

// Символьные триграммы — устойчивы к опечаткам и разной морфологии.
Функция Триграммы(Строка)
	Результат = Новый Соответствие;
	Заготовка = "  " + Строка + " ";
	Для Позиция = 1 По СтрДлина(Заготовка) - 2 Цикл
		Результат.Вставить(Сред(Заготовка, Позиция, 3), Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// --- меры близости ----------------------------------------------------------

// Доля токенов справочной позиции, найденных в строке поставщика.
Функция Вхождение(ТокеныКандидата, ТокеныПоставщика)
	Если ТокеныКандидата.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Индекс = ВМножество(ТокеныПоставщика);
	Совпало = 0;
	Для Каждого Токен Из ТокеныКандидата Цикл
		Если Индекс.Получить(Токен) <> Неопределено Тогда
			Совпало = Совпало + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Совпало / ТокеныКандидата.Количество();
КонецФункции

Функция Жаккар(Первые, Вторые)
	Если Первые.Количество() = 0 ИЛИ Вторые.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Индекс = ВМножество(Вторые);
	Пересечение = 0;
	Для Каждого Токен Из Первые Цикл
		Если Индекс.Получить(Токен) <> Неопределено Тогда
			Пересечение = Пересечение + 1;
		КонецЕсли;
	КонецЦикла;
	Объединение = Первые.Количество() + Вторые.Количество() - Пересечение;
	Возврат ?(Объединение = 0, 0, Пересечение / Объединение);
КонецФункции

Функция БлизостьМножеств(Первое, Второе)
	Если Первое.Количество() = 0 ИЛИ Второе.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Пересечение = 0;
	Для Каждого Элемент Из Первое Цикл
		Если Второе.Получить(Элемент.Ключ) <> Неопределено Тогда
			Пересечение = Пересечение + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Пересечение / Sqrt(Первое.Количество() * Второе.Количество());
КонецФункции

Функция ДоляСовпавшихБрендов(Бренды, ТокеныПоставщика)
	Если Бренды.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Индекс = ВМножество(ТокеныПоставщика);
	Совпало = 0;
	Для Каждого Бренд Из Бренды Цикл
		Если Индекс.Получить(Бренд) <> Неопределено Тогда
			Совпало = Совпало + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Совпало / Бренды.Количество();
КонецФункции

Функция ВеличиныСовпали(Первые, Вторые)
	Для Каждого Первая Из Первые Цикл
		Для Каждого Вторая Из Вторые Цикл
			Если Первая.Единица = Вторая.Единица
				И Макс(Первая.Количество - Вторая.Количество,
				       Вторая.Количество - Первая.Количество) < 0.01 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// --- атрибуты ---------------------------------------------------------------

// Размер ищем только как самостоятельный токен: иначе «S» найдётся внутри
// любого латинского бренда, а «М» — внутри русского слова.
Функция ИзвлечьРазмер(Наименование)

	Заготовка = ВРег(РазделитьАлфавиты(Наименование));
	Токены = РазбитьНаСлова(Заготовка);

	// длинные размеры проверяем первыми, иначе «XL» найдётся внутри «XXL»
	Для Каждого Размер Из СтрРазделить("XXXL,XXL,XL,XS,S,M,L", ",", Ложь) Цикл
		Если Токены.Получить(Размер) <> Неопределено Тогда
			Возврат Размер;
		КонецЕсли;
	КонецЦикла;

	// кириллические омоглифы: бухгалтер набирает русскую «М» вместо латинской
	Омоглифы = Новый Соответствие;
	Омоглифы.Вставить("ХС", "XS");
	Омоглифы.Вставить("С", "S");
	Омоглифы.Вставить("М", "M");
	Омоглифы.Вставить("Л", "L");
	Омоглифы.Вставить("ХЛ", "XL");
	Для Каждого Пара Из Омоглифы Цикл
		Если Токены.Получить(Пара.Ключ) <> Неопределено Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИзвлечьЦвет(Наименование)

	Заготовка = НРег(СтрЗаменить(РазделитьАлфавиты(Наименование), "ё", "е"));
	Токены = РазбитьНаСлова(Заготовка);

	Цвета = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить(
		"белый:белый,белая:белый,бел:белый,white:белый,"
		+ "черный:черный,черная:черный,чер:черный,black:черный,"
		+ "красный:красный,красная:красный,red:красный,"
		+ "синий:синий,синяя:синий,blue:синий,"
		+ "зеленый:зеленый,green:зеленый,"
		+ "серый:серый,grey:серый,gray:серый", ",", Ложь) Цикл
		Части = СтрРазделить(Пара, ":", Ложь);
		Цвета.Вставить(Части[0], Части[1]);
	КонецЦикла;

	Для Каждого Пара Из Токены Цикл
		Цвет = Цвета.Получить(Пара.Ключ);
		Если Цвет <> Неопределено Тогда
			Возврат Цвет;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// --- мелочи -----------------------------------------------------------------

Функция РазбитьНаСлова(Строка)
	Заготовка = Строка;
	Разделители = "()[]{}.,;:!?/\-_""'`«»%*+ ";
	Для Позиция = 1 По СтрДлина(Разделители) Цикл
		Заготовка = СтрЗаменить(Заготовка, Сред(Разделители, Позиция, 1), " ");
	КонецЦикла;
	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(Заготовка, " ", Ложь) Цикл
		Если НЕ ПустаяСтрока(Слово) Тогда
			Результат.Вставить(СокрЛП(Слово), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВМножество(Массив)
	Результат = Новый Соответствие;
	Для Каждого Элемент Из Массив Цикл
		Результат.Вставить(Элемент, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоЛатинскийТокен(Токен)
	Для Позиция = 1 По СтрДлина(Токен) Цикл
		Тип = ТипСимвола(Сред(Токен, Позиция, 1));
		Если Тип = "cyr" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СодержитЦифру(Строка)
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789", Сред(Строка, Позиция, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоЧисло(Строка)
	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789.", Сред(Строка, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти
