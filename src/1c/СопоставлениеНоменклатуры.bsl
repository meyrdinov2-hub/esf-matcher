////////////////////////////////////////////////////////////////////////////////
// Общий модуль «СопоставлениеНоменклатуры»
//
// Порт движка, отлаженного на JavaScript (см. src/normalize.js,
// src/match/pipeline.js). Логика и пороги совпадают намеренно: результаты
// сверяются с эталонной реализацией на одних и тех же данных, расхождение
// означает ошибку порта.
//
// Слои сопоставления, от дешёвых к дорогим:
//   1. память     — пара уже подтверждалась человеком (регистр сведений);
//   2. точное     — нормализованные наименования совпали дословно;
//   3. нечёткое   — близость по токенам, триграммам, бренду, фасовке.
//
// Принцип: тихая ошибка дороже отказа. Строка, где два кандидата почти
// равны, не заполняется автоматически — она уходит человеку на проверку.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подбирает номенклатуру для строки поставщика.
//
// Параметры:
//   НаименованиеПоставщика - Строка - как товар назвал поставщик
//   Контрагент             - СправочникСсылка.Контрагенты
//   Кандидаты              - ТаблицаЗначений - подготовленный справочник,
//                            см. ПодготовитьКандидатов()
//
// Возвращаемое значение:
//   Структура:
//     * Номенклатура - СправочникСсылка.Номенклатура, Неопределено
//     * Уверенность  - Число (0..1)
//     * Слой         - Строка ("Память", "Точное", "Нечёткое", "Нет")
//     * Обоснование  - Строка - почему принято такое решение
//     * Варианты     - Массив структур - до четырёх лучших кандидатов
//
Функция ПодобратьНоменклатуру(НаименованиеПоставщика, Контрагент, Кандидаты) Экспорт

	Результат = ПустойРезультат();

	// --- слой 1: память подтверждённых сопоставлений ---
	ИзПамяти = НайтиВПамяти(НаименованиеПоставщика, Контрагент);
	Если ЗначениеЗаполнено(ИзПамяти) Тогда
		Результат.Номенклатура = ИзПамяти.Номенклатура;
		Результат.Уверенность  = 0.99;
		Результат.Слой         = "Память";
		Результат.Обоснование  = "подтверждалось ранее (" + ИзПамяти.КоличествоПодтверждений + "×)";
		Возврат Результат;
	КонецЕсли;

	Разобранное = РазобратьНаименование(НаименованиеПоставщика);

	// --- слой 2: точное совпадение нормализованных наименований ---
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Очищенное = Разобранное.Очищенное Тогда
			Результат.Номенклатура = Кандидат.Номенклатура;
			Результат.Уверенность  = 0.95;
			Результат.Слой         = "Точное";
			Результат.Обоснование  = "наименования совпали дословно";
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	// --- слой 3: нечёткое сопоставление ---
	Оценки = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл

		// Жёсткий фильтр по размеру и цвету — до всякой близости.
		// Без него «Поло (белый XS)» и «Поло (белый XXL)» неразличимы:
		// они отличаются двумя символами из шестидесяти, и нечёткая мера
		// уверенно подставит не тот размер. Молча.
		Если НЕ АтрибутыСовместимы(Разобранное, Кандидат) Тогда
			Продолжить;
		КонецЕсли;

		Оценка = Новый Структура("Номенклатура, Наименование, Близость");
		Оценка.Номенклатура = Кандидат.Номенклатура;
		Оценка.Наименование = Кандидат.Наименование;
		Оценка.Близость     = Близость(Разобранное, Кандидат);
		Оценки.Добавить(Оценка);

	КонецЦикла;

	ОтсортироватьПоУбываниюБлизости(Оценки);

	Если Оценки.Количество() = 0 Тогда
		Результат.Обоснование = "похожих позиций не найдено";
		Возврат Результат;
	КонецЕсли;

	Лучший = Оценки[0];
	Второй = ?(Оценки.Количество() > 1, Оценки[1], Неопределено);
	Результат.Варианты = ПервыеВарианты(Оценки, 4);

	Если Лучший.Близость < МинимальнаяБлизость() Тогда
		Результат.Обоснование = "похожих позиций не найдено";
		Возврат Результат;
	КонецЕсли;

	Отрыв = Лучший.Близость - ?(Второй = Неопределено, 0, Второй.Близость);

	Если Отрыв < МинимальныйОтрыв() Тогда
		// Кандидаты неразличимы — это повод спросить, а не угадывать.
		Результат.Уверенность = 0.4;
		Результат.Слой        = "Нечёткое";
		Результат.Обоснование = "неоднозначно: «" + Лучший.Наименование
			+ "» и «" + Второй.Наименование + "» почти равны";
		Возврат Результат;
	КонецЕсли;

	Результат.Номенклатура = Лучший.Номенклатура;
	Результат.Уверенность  = Мин(0.94, 0.5 + Лучший.Близость * 0.35 + Мин(Отрыв, 0.3) * 0.5);
	Результат.Слой         = "Нечёткое";
	Результат.Обоснование  = "близость " + Формат(Лучший.Близость, "ЧДЦ=2")
		+ ", отрыв " + Формат(Отрыв, "ЧДЦ=2");

	Возврат Результат;

КонецФункции

// Готовит справочник номенклатуры к сопоставлению: разбирает наименования
// один раз, чтобы не делать это для каждой строки документа заново.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Номенклатура, Наименование, Очищенное,
//                     Токены, Триграммы, Латиница, Величины, Размер, Цвет
//
Функция ПодготовитьКандидатов() Экспорт

	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Номенклатура");
	Кандидаты.Колонки.Добавить("Наименование");
	Кандидаты.Колонки.Добавить("Очищенное");
	Кандидаты.Колонки.Добавить("Токены");
	Кандидаты.Колонки.Добавить("Триграммы");
	Кандидаты.Колонки.Добавить("Латиница");
	Кандидаты.Колонки.Добавить("Величины");
	Кандидаты.Колонки.Добавить("Размер");
	Кандидаты.Колонки.Добавить("Цвет");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Разобранное = РазобратьНаименование(Выборка.Наименование);
		Строка = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Разобранное);
		Строка.Номенклатура = Выборка.Ссылка;
		Строка.Наименование = Выборка.Наименование;
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

// Запоминает подтверждённое человеком сопоставление.
// Именно этот вызов делает систему умнее с каждым документом.
//
Процедура ЗапомнитьСопоставление(НаименованиеПоставщика, Контрагент, Номенклатура) Экспорт

	Разобранное = РазобратьНаименование(НаименованиеПоставщика);

	Менеджер = РегистрыСведений.СоответствияНоменклатурыПоставщиков.СоздатьМенеджерЗаписи();
	Менеджер.Контрагент = Контрагент;
	Менеджер.НаименованиеНормализованное = Разобранное.Очищенное;
	Менеджер.Прочитать();

	Менеджер.Контрагент = Контрагент;
	Менеджер.НаименованиеНормализованное = Разобранное.Очищенное;
	Менеджер.НаименованиеИсходное = НаименованиеПоставщика;
	Менеджер.Номенклатура = Номенклатура;
	Менеджер.КоличествоПодтверждений = ?(Менеджер.Выбран(), Менеджер.КоличествоПодтверждений, 0) + 1;
	Менеджер.ДатаПоследнего = ТекущаяДатаСеанса();
	Менеджер.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустойРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Неопределено);
	Результат.Вставить("Уверенность", 0);
	Результат.Вставить("Слой", "Нет");
	Результат.Вставить("Обоснование", "");
	Результат.Вставить("Варианты", Новый Массив);
	Возврат Результат;
КонецФункции

// Порог, ниже которого даже лучший кандидат не рассматривается.
Функция МинимальнаяБлизость()
	Возврат 0.55;
КонецФункции

// Насколько лучший кандидат должен опережать второго. Малый отрыв означает,
// что позиции неотличимы, и решать должен человек, а не округление.
Функция МинимальныйОтрыв()
	Возврат 0.08;
КонецФункции

Функция НайтиВПамяти(НаименованиеПоставщика, Контрагент)

	Разобранное = РазобратьНаименование(НаименованиеПоставщика);

	Отбор = Новый Структура;
	Отбор.Вставить("Контрагент", Контрагент);
	Отбор.Вставить("НаименованиеНормализованное", Разобранное.Очищенное);

	Записи = РегистрыСведений.СоответствияНоменклатурыПоставщиков.Получить(Отбор);
	Если ЗначениеЗаполнено(Записи.Номенклатура) Тогда
		Возврат Записи;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
